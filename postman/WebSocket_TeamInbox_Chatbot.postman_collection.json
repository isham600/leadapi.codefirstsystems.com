          },
          "response": []
        }
      ]
    },

    {
      "name": "💡 WS Test Scenarios",
      "item": [
        {
          "name": "Simulate — POST inbound chatbot message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhook/{{uuid}}/chatbot",
              "host": ["{{base_url}}"],
              "path": ["api", "webhook", "{{uuid}}", "chatbot"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"id\": \"msg_{{$randomUUID}}\",\n    \"from\": \"919876543210\",\n    \"type\": \"text\",\n    \"text\": { \"body\": \"hi\" }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Triggers the chatbot flow. Watch WS client for `new_message` + `conversation_update` events.\n\nThe chatbot engine will:\n1. Match keyword `hi` → find a flow\n2. Send flow messages back via WhatsApp API\n3. Push WS events to connected clients"
          },
          "response": [
            {
              "name": "200 OK — instant ack",
              "status": "OK",
              "code": 200,
              "body": "{ \"status\": 1, \"message\": \"OK\" }"
            }
          ]
        },
        {
          "name": "Simulate — POST inbound whatsapp message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhook/{{uuid}}/whatsapp",
              "host": ["{{base_url}}"],
              "path": ["api", "webhook", "{{uuid}}", "whatsapp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WABA_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"918888888888\",\n              \"phone_number_id\": \"PHONE_NUMBER_ID\"\n            },\n            \"messages\": [\n              {\n                \"from\": \"919876543210\",\n                \"id\": \"wamid.test123\",\n                \"timestamp\": \"1700000000\",\n                \"type\": \"text\",\n                \"text\": { \"body\": \"Hello from WhatsApp!\" }\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Simulates an inbound WhatsApp message. Watch WS for real-time event."
          },
          "response": []
        }
      ]
    }

  ]
}

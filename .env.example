# ============================================================
# SERVER
# ============================================================
NODE_ENV=development                        # development | production
PORT=3004                                   # port the Fastify server listens on
BASE_URL=http://localhost:3004              # public URL of THIS backend (used in avatar URLs etc.)
FRONTEND_URL=http://localhost:3000          # public URL of the frontend app (used in OAuth redirects)

# ============================================================
# MYSQL DATABASE
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root                             # your DB username
MYSQL_PASSWORD=your_db_password             # your DB password
MYSQL_DATABASE=indew_lead_db                # your DB name

# ============================================================
# AUTHENTICATION / SECURITY
# ============================================================
JWT_SECRET=change_me_to_a_random_64_char_string   # min 32 chars — keep secret
COOKIE_SECRET=change_me_to_a_random_64_char_string # min 32 chars — used to sign cookies

# Optional: lets admins log in as any user with this hashed password
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpass',10).then(console.log)"
MASTER_PASSWORD=                            # bcrypt hash of master password (leave blank to disable)

# ============================================================
# CORS
# Comma-separated list of allowed frontend origins.
# In production this MUST be set — the server will refuse to start without it.
# In development you can leave it blank (all origins allowed).
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ============================================================
# SMTP EMAIL
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                           # true for port 465, false for 587
SMTP_USER=your@email.com                    # your SMTP login / sender address
SMTP_PASS=your_smtp_app_password            # Gmail: use an App Password, not your account password
SMTP_FROM_NAME=Indew Lead
SMTP_FROM_EMAIL=your@email.com

# ============================================================
# META / FACEBOOK LEAD ADS
# Docs: https://developers.facebook.com/apps
# ============================================================
META_APP_ID=                                # Facebook App ID (Settings → Basic)
META_APP_SECRET=                            # Facebook App Secret (Settings → Basic → Show)
META_REDIRECT_URI=https://apilead.nuke.co.in/api/meta/oauth/callback
                                            # Must match exactly what is saved in:
                                            # Facebook Login → Settings → Valid OAuth Redirect URIs

META_WEBHOOK_VERIFY_TOKEN=any_random_string # any string — paste the same value in the Meta webhook config
META_DUMMY_MODE=false                       # true → webhook stores dummy leads (useful during development)

# Legacy Facebook webhook (separate integration, not OAuth)
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=

# ============================================================
# GOOGLE ADS OAuth
# Docs: https://console.cloud.google.com → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add redirect URI: https://apilead.nuke.co.in/api/google/oauth/callback
# 3. Enable "Google Ads API" in the Library
# ============================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=https://apilead.nuke.co.in/api/google/oauth/callback
                                            # Must match exactly what is saved in Google Cloud Console
GOOGLE_ADS_DEVELOPER_TOKEN=B9aBGOKIm2vhVmi8w8NHbw
                 # From ads.google.com/aw/apicenter — one token for your whole app

# ============================================================
# RAZORPAY (Payment Gateway) — currently disabled in code
# ============================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ============================================================
# REDIS — Optional, only needed if rate limiting is enabled
# Uncomment the rate-limit block in app.ts to activate
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

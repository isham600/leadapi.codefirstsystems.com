# FastAGI server port (must match dialplan: agi://127.0.0.1:PORT)
AGI_PORT=4573

# Asterisk sounds directory (TTS files written directly here — no SCP needed)
SOUNDS_DIR=/var/lib/asterisk/sounds

# Gemini API key (from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (gemini-2.5-flash-lite is fast and cost-effective)
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Cloud service account JSON for TTS + STT
GOOGLE_APPLICATION_CREDENTIALS=/root/ai-call-agi/google-service-account.json

# API server base URL — used for the HTTP callback when call ends
# Format: http://your-api-server-ip:port/api/users/phone-ivr/ai/calls
AI_CALLBACK_URL=http://YOUR_API_SERVER_IP:3000/api/users/phone-ivr/ai/calls
